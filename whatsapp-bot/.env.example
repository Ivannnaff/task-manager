# Nomor tujuan kini diisi per user lewat halaman pengaturan di aplikasi.
# Variabel WA_TARGET_NUMBER tidak dipakai lagi.

# Nomor WhatsApp yang akan dijadikan bot (untuk pairing code, tanpa +)
# Kosongkan jika ingin scan QR biasa
WA_PAIRING_NUMBER=

# URL backend Next.js
API_URL=http://localhost:3000/api

# API key service untuk mengambil daftar tugas (harus sama dengan BACKEND_API_KEY di backend)
BACKEND_API_KEY=

# Supabase (untuk log anti-spam wa_logs)
SUPABASE_URL=https://bvtvetllfhykpgaodiyf.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jadwal pengecekan (menit jam hari bulan hari-minggu)
CRON_MORNING=0 7 * * *
CRON_EVENING=0 20 * * *

# Timezone untuk jadwal cron (default: Asia/Jakarta / WIB)
CRON_TZ=Asia/Jakarta

# Berapa hari sebelum deadline dianggap mepet (maks H-n)
URGENT_THRESHOLD=2

# Anti-spam: true = kirim maks 1x per tugas per slot per hari (via wa_logs)
#            false = selalu kirim tiap trigger (hati-hati spam)
ANTI_SPAM=true

# Mode pesan: true = gabung semua tugas mepet jadi 1 pesan (digest)
#             false = 1 pesan per tugas
DIGEST=true

# Batas maksimal pesan terkirim per hari (0 = tanpa batas)
# Catatan: hitungan memakai file lokal, tidak persist di GitHub Actions
MAX_SENDS_PER_DAY=50

# Opsi khusus mode --once (dipakai GitHub Actions)
# Slot pesan: AM / PM / TEST (bisa juga lewat argumen --slot)
# WA_SLOT=TEST
# Timeout menunggu koneksi WhatsApp open, milidetik (default 60000)
# ONCE_TIMEOUT_MS=60000
